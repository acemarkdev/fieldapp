# Copy to .env and fill in. NEVER commit the real .env.

# Supabase (from your project's API settings)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key            # public/safe — used for login in the office app
SUPABASE_SERVICE_ROLE_KEY=your-service-key # server/backend ONLY — never ships to a client

# Monday.com (server-side only — set in the backend, never in the app)
MONDAY_API_TOKEN=your-monday-personal-or-app-token

# Microsoft SSO (optional). Set to true only AFTER configuring the Azure provider in
# Supabase (see docs/sso-setup.md). Shows the "Sign in with Microsoft" button (office web app).
AZURE_SSO_ENABLED=false

# Mobile app SSO. Shows "Sign in with Microsoft" on the phone login. Also add the mobile
# redirect (acefield://auth-callback) to Supabase's Redirect URLs — see docs/mobile-sso-setup.md.
EXPO_PUBLIC_AZURE_SSO_ENABLED=false

# Live wallboard (optional). Set any secret to enable the /live auto-refresh page,
# then open  http://localhost:3000/live?key=YOUR_LIVE_KEY  and pin the tab.
LIVE_KEY=

# Vision assist (optional, Phase A frame recognition). Any OpenAI-compatible vision endpoint:
# hosted (e.g. https://api.openai.com/v1 + a gpt-4o-class model) or a self-hosted Qwen-VL via vLLM.
# Leave blank to keep recognition off. See docs/frame-recognition-data-strategy.md.
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
