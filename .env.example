# Copy to .env and fill in. NEVER commit the real .env.

# Supabase (from your project's API settings)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key            # public/safe — used for login in the office app
SUPABASE_SERVICE_ROLE_KEY=your-service-key # server/backend ONLY — never ships to a client

# Monday.com (server-side only — set in the backend, never in the app)
MONDAY_API_TOKEN=your-monday-personal-or-app-token

# Microsoft SSO (optional). Set to true only AFTER configuring the Azure provider in
# Supabase (see docs/sso-setup.md). Shows the "Sign in with Microsoft" button.
AZURE_SSO_ENABLED=false
