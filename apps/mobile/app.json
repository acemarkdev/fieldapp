{
  "expo": {
    "name": "FitAWindow",
    "slug": "ace-field",
    "version": "0.65.1",
    "orientation": "portrait",
    "scheme": "acefield",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#3a2b72" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "uk.co.acegroup.field" },
    "android": { "package": "uk.co.acegroup.field", "versionCode": 1 },
    "web": { "bundler": "metro" },
    "plugins": [
      ["expo-image-picker", {
        "photosPermission": "FitAWindow needs access to your photos to attach survey images.",
        "cameraPermission": "FitAWindow needs the camera to take survey photos."
      }]
    ]
  }
}
