{
  "expo": {
    "name": "ACE Field",
    "slug": "ace-field",
    "version": "0.64.0",
    "orientation": "portrait",
    "scheme": "acefield",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#3a2b72" },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": { "package": "uk.co.acegroup.field" },
    "web": { "bundler": "metro" },
    "plugins": [
      ["expo-image-picker", {
        "photosPermission": "ACE Field needs access to your photos to attach survey images.",
        "cameraPermission": "ACE Field needs the camera to take survey photos."
      }]
    ]
  }
}
