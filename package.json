{
  "name": "ace-fieldapp",
  "private": true,
  "version": "0.0.1",
  "description": "ACE Group field survey app \u2014 mobile (Expo), office web (React) and sync backend, on a multi-tenant Supabase store.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "tsc -p apps/api && apps/mobile/node_modules/.bin/tsc --noEmit -p apps/mobile",
    "test": "npm --workspaces --if-present run test"
  },
  "dependencies": {
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "xlsx": "^0.18.5"
  }
}
